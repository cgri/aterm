# Line endings are pinned here so a clone behaves the same regardless of the
# machine's core.autocrlf setting.

# Store every text file with LF in the repository and check it out as LF.
* text=auto eol=lf

# Windows scripts are executed by cmd.exe and PowerShell, which are happiest
# with CRLF — .bat and .cmd in particular break without it. The NSIS include is
# read by makensis, which is happier with CRLF as well.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.nsh text eol=crlf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.node binary
*.7z binary
*.zip binary

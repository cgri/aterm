{
  "name": "aterm",
  "version": "1.2.1",
  "description": "A lean terminal host with tab and session handling for Claude Code",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/setup-builder-cache.mjs && electron-vite build && electron-builder --win --x64",
    "build:dir": "electron-vite build && electron-builder --win --dir --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup": "node scripts/setup-native.mjs",
    "setup:force": "node scripts/setup-native.mjs --force",
    "postinstall": "node scripts/setup-native.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "comments": {
    "overrides": "node-gyp <10 nutzt distutils, das es in Python 3.12 nicht mehr gibt."
  },
  "overrides": {
    "node-gyp": "^11.2.0"
  },
  "build": {
    "appId": "de.aterm.app",
    "productName": "aterm",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/aterm-profile.ps1",
        "to": "aterm-profile.ps1"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^39.0.0",
    "electron-builder": "~25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3"
  }
}
